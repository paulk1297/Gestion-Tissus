<%- include('../partials/header', { titrePage: (item ? 'Modifier' : 'Nouvelle') + ' vente' }) %>

<h3 class="mb-4"><%= item && item.id ? 'Modifier la vente' : 'Nouvelle vente de tissu cousu' %></h3>

<div class="row justify-content-center">
  <div class="col-md-8">
    <% if (!item) { %>
    <div class="card mb-3">
      <div class="card-body p-3">
        <strong>Stock cousu disponible :</strong>
        <% if (stockDisponible.length === 0) { %>
          <span class="text-muted">aucun stock enregistré.</span>
        <% } else { %>
          <ul class="mb-0 small">
            <% stockDisponible.forEach(s => { %>
              <li><%= s.qualite %> / <%= s.modele %> : <strong><%= s.stock_disponible %></strong> disponible</li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
    <% } %>
    <div class="card">
      <div class="card-body p-4">
        <% if (erreur) { %><div class="alert alert-danger py-2"><%= erreur %></div><% } %>
        <% if (clients.length === 0) { %>
          <div class="alert alert-warning">Aucun client enregistré. <a href="/clients/nouveau">Ajoutez d'abord un client</a>.</div>
        <% } %>
        <% if (stockDisponible.length === 0) { %>
          <div class="alert alert-warning">Aucun tissu cousu en stock pour le moment. Marquez d'abord une <a href="/commandes">commande de couture</a> comme reçue.</div>
        <% } %>
        <form action="<%= item && item.id ? '/ventes/' + item.id : '/ventes' %>" method="POST">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Client *</label>
              <select name="client_id" class="form-select" required>
                <option value="">-- Choisir --</option>
                <% clients.forEach(c => { %>
                  <option value="<%= c.id %>" <%= item && String(item.client_id) === String(c.id) ? 'selected' : '' %>><%= c.nom %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Date de vente</label>
              <input type="date" name="date_vente" class="form-control" value="<%= item && item.date_vente ? item.date_vente : new Date().toISOString().slice(0,10) %>">
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Qualité *</label>
              <select id="champ-qualite" name="qualite" class="form-select" required>
                <option value="">-- Choisir --</option>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Modèle *</label>
              <select id="champ-modele" name="modele" class="form-select" required>
                <option value="">-- Choisir --</option>
              </select>
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Prix unitaire de vente *</label>
              <input type="number" step="0.01" min="0" name="prix_unitaire_vente" class="form-control" value="<%= item && item.prix_unitaire_vente ? item.prix_unitaire_vente : '' %>" required>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Quantité *</label>
              <input type="number" step="0.01" min="0" name="quantite" id="champ-quantite" class="form-control" value="<%= item && item.quantite ? item.quantite : '' %>" required>
              <div class="form-text" id="info-stock-max"></div>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Montant déjà payé</label>
              <input type="number" step="0.01" min="0" name="montant_paye" class="form-control" value="<%= item && item.montant_paye ? item.montant_paye : 0 %>">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Notes</label>
            <textarea name="notes" class="form-control" rows="2"><%= item && item.notes ? item.notes : '' %></textarea>
          </div>
          <button type="submit" class="btn btn-brand">Enregistrer</button>
          <a href="/ventes" class="btn btn-link">Annuler</a>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  // Alimente les listes déroulantes "Qualité" et "Modèle" à partir du stock
  // de tissus cousus déjà enregistré (évite les fautes de frappe qui
  // casseraient le calcul du stock, qui repose sur une correspondance exacte).
  (function () {
    var stockTissus = <%- JSON.stringify(stockDisponible.map(function (s) { return { qualite: s.qualite, modele: s.modele, stock: s.stock_disponible }; })) %>;
    var qualiteActuelle = <%- JSON.stringify(item && item.qualite ? item.qualite : '') %>;
    var modeleActuel = <%- JSON.stringify(item && item.modele ? item.modele : '') %>;

    var selectQualite = document.getElementById('champ-qualite');
    var selectModele = document.getElementById('champ-modele');
    var champQuantite = document.getElementById('champ-quantite');
    var infoStockMax = document.getElementById('info-stock-max');

    // En modification, la vente en cours a déjà été déduite du stock
    // disponible : si on ne change pas l'article, il faut donc réajouter sa
    // propre quantité pour savoir combien il reste réellement « à côté ».
    var venteActuelleQualite = <%- JSON.stringify(item && item.id ? item.qualite : '') %>;
    var venteActuelleModele = <%- JSON.stringify(item && item.id ? item.modele : '') %>;
    var venteActuelleQuantite = <%- JSON.stringify(item && item.id && item.quantite ? parseFloat(item.quantite) : 0) %>;

    var qualites = [];
    stockTissus.forEach(function (s) {
      if (qualites.indexOf(s.qualite) === -1) qualites.push(s.qualite);
    });
    if (qualiteActuelle && qualites.indexOf(qualiteActuelle) === -1) qualites.push(qualiteActuelle);
    qualites.sort(function (a, b) { return a.localeCompare(b); });

    qualites.forEach(function (q) {
      var option = document.createElement('option');
      option.value = q;
      option.textContent = q;
      if (q === qualiteActuelle) option.selected = true;
      selectQualite.appendChild(option);
    });

    function remplirModele(qualite, preselection) {
      selectModele.innerHTML = '<option value="">-- Choisir --</option>';
      var modeles = [];
      stockTissus
        .filter(function (s) { return s.qualite === qualite && s.modele; })
        .forEach(function (s) {
          if (!modeles.some(function (m) { return m.modele === s.modele; })) {
            modeles.push({ modele: s.modele, stock: s.stock });
          }
        });
      if (preselection && !modeles.some(function (m) { return m.modele === preselection; })) {
        modeles.push({ modele: preselection, stock: null });
      }
      modeles.sort(function (a, b) { return a.modele.localeCompare(b.modele); });
      modeles.forEach(function (m) {
        var option = document.createElement('option');
        option.value = m.modele;
        option.textContent = m.stock !== null ? m.modele + ' (' + m.stock + ' disponible)' : m.modele;
        if (m.modele === preselection) option.selected = true;
        selectModele.appendChild(option);
      });
    }

    remplirModele(qualiteActuelle, modeleActuel);

    // Contrôle du stock disponible : empêche la validation du formulaire si
    // la quantité saisie dépasse le stock cousu réellement disponible pour
    // la combinaison qualité/modèle choisie.
    function stockDisponiblePour(qualite, modele) {
      var trouve = stockTissus.filter(function (s) { return s.qualite === qualite && s.modele === modele; })[0];
      var disponible = trouve ? trouve.stock : 0;
      if (qualite === venteActuelleQualite && modele === venteActuelleModele) {
        disponible += venteActuelleQuantite;
      }
      return disponible;
    }

    function verifierStock() {
      var qualite = selectQualite.value;
      var modele = selectModele.value;
      if (!qualite || !modele) {
        infoStockMax.textContent = '';
        champQuantite.setCustomValidity('');
        return;
      }
      var disponible = stockDisponiblePour(qualite, modele);
      infoStockMax.textContent = 'Stock disponible pour cet article : ' + disponible;
      var quantiteSaisie = parseFloat(champQuantite.value);
      if (!isNaN(quantiteSaisie) && quantiteSaisie > disponible) {
        champQuantite.setCustomValidity('La quantité dépasse le stock disponible (' + disponible + ').');
      } else {
        champQuantite.setCustomValidity('');
      }
    }

    selectQualite.addEventListener('change', function () {
      remplirModele(selectQualite.value, '');
      verifierStock();
    });
    selectModele.addEventListener('change', verifierStock);
    champQuantite.addEventListener('input', verifierStock);

    verifierStock();
  })();
</script>

<%- include('../partials/footer') %>
