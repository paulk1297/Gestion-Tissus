<%- include('../partials/header', { titrePage: titrePluriel.charAt(0).toUpperCase() + titrePluriel.slice(1) }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0 text-capitalize"><%= titrePluriel %></h3>
  <a href="/<%= titrePluriel %>/nouveau" class="btn btn-brand">+ Ajouter un <%= titreSingulier %></a>
</div>

<form class="mb-3" method="GET">
  <input type="text" name="q" value="<%= recherche %>" class="form-control" placeholder="Rechercher par nom, lieu ou téléphone...">
</form>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr>
          <th>Nom</th>
          <th>Lieu</th>
          <th>Téléphone</th>
          <th>WhatsApp</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (lignes.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted py-4">Aucun <%= titreSingulier %> enregistré pour le moment.</td></tr>
        <% } %>
        <% lignes.forEach(item => { %>
        <tr>
          <td><%= item.nom %></td>
          <td><%= item.lieu || '—' %></td>
          <td><%= item.telephone || '—' %></td>
          <td>
            <% if (item.whatsapp) { %>
              <a href="https://wa.me/<%= item.whatsapp.replace(/[^0-9]/g, '') %>" target="_blank" rel="noopener">💬 <%= item.whatsapp %></a>
            <% } else { %>—<% } %>
          </td>
          <td class="text-end">
            <a href="/<%= titrePluriel %>/<%= item.id %>/modifier" class="btn btn-sm btn-outline-secondary">Modifier</a>
            <form action="/<%= titrePluriel %>/<%= item.id %>/supprimer" method="POST" class="d-inline"
                  onsubmit="return confirm('Supprimer ce <%= titreSingulier %> ?');">
              <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
