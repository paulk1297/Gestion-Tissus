<%- include('partials/header', { titrePage: 'Stock tissus cousus' }) %>

<h3 class="mb-4">Stock de tissus cousus</h3>
<p class="text-muted">Quantité reçue des couturiers (commandes marquées "reçues"), moins la quantité vendue aux clients.</p>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr>
          <th>Qualité</th>
          <th>Modèle</th>
          <th class="text-end">Total reçu des couturiers</th>
          <th class="text-end">Total vendu</th>
          <th class="text-end">Stock disponible</th>
        </tr>
      </thead>
      <tbody>
        <% if (stock.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted py-4">Aucun stock enregistré pour le moment.</td></tr>
        <% } %>
        <% stock.forEach(s => { %>
        <tr>
          <td><%= s.qualite %></td>
          <td><%= s.modele %></td>
          <td class="text-end"><%= s.total_recu %></td>
          <td class="text-end"><%= s.total_vendu %></td>
          <td class="text-end <%= s.stock_disponible <= 0 ? 'stock-faible' : 'fw-bold' %>"><%= s.stock_disponible %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
