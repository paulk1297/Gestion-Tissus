<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof titrePage !== 'undefined' ? titrePage + ' — Gestion Tissus' : 'Gestion Tissus' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<% if (currentUser) { %>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">🧵 Gestion Tissus</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item"><a class="nav-link" href="/">Tableau de bord</a></li>
        <li class="nav-item"><a class="nav-link" href="/fournisseurs">Fournisseurs</a></li>
        <li class="nav-item"><a class="nav-link" href="/couturiers">Couturiers</a></li>
        <li class="nav-item"><a class="nav-link" href="/clients">Clients</a></li>
        <li class="nav-item"><a class="nav-link" href="/achats">Achats</a></li>
        <li class="nav-item"><a class="nav-link" href="/commandes">Commandes couture</a></li>
        <li class="nav-item"><a class="nav-link" href="/ventes">Ventes</a></li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Stock</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/stock/non-cousu">Tissus non cousus</a></li>
            <li><a class="dropdown-item" href="/stock/cousu">Tissus cousus</a></li>
          </ul>
        </li>
        <% if (currentUser.role === 'admin') { %>
        <li class="nav-item"><a class="nav-link" href="/utilisateurs">Utilisateurs</a></li>
        <% } %>
      </ul>
      <ul class="navbar-nav">
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
            <%= currentUser.nom %> <span class="badge bg-secondary"><%= currentUser.role === 'admin' ? 'Admin' : 'Employé' %></span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/compte">Mon compte</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="/logout" method="POST" class="px-3">
                <button type="submit" class="btn btn-link p-0 dropdown-item">Déconnexion</button>
              </form>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>
<% } %>
<main class="container-fluid py-4" style="max-width: 1200px;">
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
      <%= flash.message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
