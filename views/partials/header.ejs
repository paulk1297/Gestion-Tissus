<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof titrePage !== 'undefined' ? titrePage + ' — Gestion Tissus' : 'Gestion Tissus' %></title>
  <script>
    // Applique le style de couleur et le mode clair/sombre choisis AVANT le
    // premier affichage, pour éviter un flash avec les mauvaises couleurs.
    // Se souvient du choix dans le navigateur (localStorage) ; à défaut,
    // respecte la préférence clair/sombre du système.
    (function () {
      try {
        var style = localStorage.getItem('tissus_theme_style') || '1';
        var mode = localStorage.getItem('tissus_theme_mode');
        if (!mode) {
          mode = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-style', style);
        document.documentElement.setAttribute('data-bs-theme', mode);
      } catch (e) {
        document.documentElement.setAttribute('data-style', '1');
        document.documentElement.setAttribute('data-bs-theme', 'light');
      }
    })();
  </script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<% if (currentUser) { %>
<nav class="navbar navbar-expand-lg navbar-dark app-navbar sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/">🧵 Gestion Tissus</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <% const peut = (m) => currentUser.role === 'admin' || (currentUser.permissions || []).includes(m); %>
    <div class="collapse navbar-collapse" id="navMenu">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item"><a class="nav-link" href="/">Tableau de bord</a></li>
        <% if (peut('fournisseurs')) { %>
        <li class="nav-item"><a class="nav-link" href="/fournisseurs">Fournisseurs</a></li>
        <% } %>
        <% if (peut('couturiers')) { %>
        <li class="nav-item"><a class="nav-link" href="/couturiers">Couturiers</a></li>
        <% } %>
        <% if (peut('clients')) { %>
        <li class="nav-item"><a class="nav-link" href="/clients">Clients</a></li>
        <% } %>
        <% if (peut('achats')) { %>
        <li class="nav-item"><a class="nav-link" href="/achats">Achats</a></li>
        <% } %>
        <% if (peut('commandes')) { %>
        <li class="nav-item"><a class="nav-link" href="/commandes">Commandes couture</a></li>
        <% } %>
        <% if (peut('ventes')) { %>
        <li class="nav-item"><a class="nav-link" href="/ventes">Ventes</a></li>
        <% } %>
        <% if (peut('stock')) { %>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">Stock</a>
          <ul class="dropdown-menu">
            <li><a class="dropdown-item" href="/stock/non-cousu">Tissus non cousus</a></li>
            <li><a class="dropdown-item" href="/stock/cousu">Tissus cousus</a></li>
          </ul>
        </li>
        <% } %>
        <% if (currentUser.role === 'admin') { %>
        <li class="nav-item"><a class="nav-link" href="/utilisateurs">Utilisateurs</a></li>
        <% } %>
      </ul>
      <ul class="navbar-nav">
        <li class="nav-item dropdown" id="menu-apparence">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" title="Apparence">🎨</a>
          <ul class="dropdown-menu dropdown-menu-end p-3" style="min-width: 230px;">
            <li class="small text-muted mb-1">Style de couleur</li>
            <li class="mb-2">
              <div class="btn-group w-100" role="group">
                <button type="button" class="btn btn-sm btn-outline-secondary btn-check-apparence" data-theme-style="1">Naturel</button>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-check-apparence" data-theme-style="2">Indigo</button>
              </div>
            </li>
            <li class="small text-muted mb-1">Mode</li>
            <li>
              <div class="btn-group w-100" role="group">
                <button type="button" class="btn btn-sm btn-outline-secondary btn-check-apparence" data-theme-mode="light">☀️ Clair</button>
                <button type="button" class="btn btn-sm btn-outline-secondary btn-check-apparence" data-theme-mode="dark">🌙 Sombre</button>
              </div>
            </li>
          </ul>
        </li>
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
            <%= currentUser.nom %> <span class="badge bg-secondary"><%= currentUser.role === 'admin' ? 'Admin' : 'Employé' %></span>
          </a>
          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/compte">Mon compte</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="/logout" method="POST" class="px-3">
                <button type="submit" class="btn btn-link p-0 dropdown-item">Déconnexion</button>
              </form>
            </li>
          </ul>
        </li>
      </ul>
    </div>
  </div>
</nav>
<% } %>
<main class="container-fluid py-4" style="max-width: 1200px;">
  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="alert alert-<%= flash.type %> alert-dismissible fade show" role="alert">
      <%= flash.message %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
