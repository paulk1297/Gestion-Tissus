<%- include('partials/header', { titrePage: 'Stock tissus non cousus' }) %>

<h3 class="mb-4">Stock de tissus non cousus</h3>
<p class="text-muted">Quantité achetée chez les fournisseurs, moins la quantité envoyée aux couturiers.</p>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr>
          <th>Qualité</th>
          <th>Nom du tissu</th>
          <th class="text-end">Total acheté</th>
          <th class="text-end">Total envoyé en couture</th>
          <th class="text-end">Stock disponible</th>
        </tr>
      </thead>
      <tbody>
        <% if (stock.length === 0) { %>
          <tr><td colspan="5" class="text-center text-muted py-4">Aucun stock enregistré pour le moment.</td></tr>
        <% } %>
        <% stock.forEach(s => { %>
        <tr>
          <td><%= s.qualite %></td>
          <td><%= s.nom_tissu %></td>
          <td class="text-end"><%= s.total_achete %></td>
          <td class="text-end"><%= s.total_envoye %></td>
          <td class="text-end <%= s.stock_disponible <= 0 ? 'stock-faible' : 'fw-bold' %>"><%= s.stock_disponible %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>
