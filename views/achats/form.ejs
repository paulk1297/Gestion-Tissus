<%- include('../partials/header', { titrePage: (item ? 'Modifier' : 'Nouvel') + ' achat' }) %>

<h3 class="mb-4"><%= item && item.id ? 'Modifier l\'achat' : 'Nouvel achat de tissu' %></h3>

<div class="row justify-content-center">
  <div class="col-md-8">
    <div class="card">
      <div class="card-body p-4">
        <% if (erreur) { %><div class="alert alert-danger py-2"><%= erreur %></div><% } %>
        <% if (fournisseurs.length === 0) { %>
          <div class="alert alert-warning">Aucun fournisseur enregistré. <a href="/fournisseurs/nouveau">Ajoutez d'abord un fournisseur</a>.</div>
        <% } %>
        <form action="<%= item && item.id ? '/achats/' + item.id : '/achats' %>" method="POST">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Fournisseur *</label>
              <select name="fournisseur_id" class="form-select" required>
                <option value="">-- Choisir --</option>
                <% fournisseurs.forEach(f => { %>
                  <option value="<%= f.id %>" <%= item && String(item.fournisseur_id) === String(f.id) ? 'selected' : '' %>><%= f.nom %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Date d'achat</label>
              <input type="date" name="date_achat" class="form-control" value="<%= item && item.date_achat ? item.date_achat : new Date().toISOString().slice(0,10) %>">
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Qualité *</label>
              <input type="text" name="qualite" class="form-control" placeholder="ex: Bazin riche, Wax, Soie..." value="<%= item && item.qualite ? item.qualite : '' %>" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Nom du tissu *</label>
              <input type="text" name="nom_tissu" class="form-control" placeholder="ex: Bazin bleu roi" value="<%= item && item.nom_tissu ? item.nom_tissu : '' %>" required>
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Prix unitaire d'achat *</label>
              <input type="number" step="0.01" min="0" name="prix_unitaire" class="form-control" value="<%= item && item.prix_unitaire ? item.prix_unitaire : '' %>" required>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Quantité *</label>
              <input type="number" step="0.01" min="0" name="quantite" class="form-control" value="<%= item && item.quantite ? item.quantite : '' %>" required>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Montant déjà payé</label>
              <input type="number" step="0.01" min="0" name="montant_paye" class="form-control" value="<%= item && item.montant_paye ? item.montant_paye : 0 %>">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Notes</label>
            <textarea name="notes" class="form-control" rows="2"><%= item && item.notes ? item.notes : '' %></textarea>
          </div>
          <button type="submit" class="btn btn-dark">Enregistrer</button>
          <a href="/achats" class="btn btn-link">Annuler</a>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
