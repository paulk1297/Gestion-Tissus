<%- include('../partials/header', { titrePage: 'Achats de tissus' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0">Achats de tissus non cousus</h3>
  <a href="/achats/nouveau" class="btn btn-dark">+ Nouvel achat</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr>
          <th>Date</th>
          <th>Fournisseur</th>
          <th>Qualité</th>
          <th>Nom du tissu</th>
          <th class="text-end">Prix unit.</th>
          <th class="text-end">Quantité</th>
          <th class="text-end">Total</th>
          <th class="text-end">Payé</th>
          <th class="text-end">Solde dû</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (lignes.length === 0) { %>
          <tr><td colspan="10" class="text-center text-muted py-4">Aucun achat enregistré pour le moment.</td></tr>
        <% } %>
        <% lignes.forEach(item => { const solde = (item.montant_total - item.montant_paye); %>
        <tr>
          <td><%= item.date_achat %></td>
          <td><%= item.fournisseur_nom %></td>
          <td><%= item.qualite %></td>
          <td><%= item.nom_tissu %></td>
          <td class="text-end"><%= item.prix_unitaire.toLocaleString('fr-FR') %></td>
          <td class="text-end"><%= item.quantite %></td>
          <td class="text-end"><%= item.montant_total.toLocaleString('fr-FR') %></td>
          <td class="text-end"><%= item.montant_paye.toLocaleString('fr-FR') %></td>
          <td class="text-end <%= solde > 0 ? 'solde-positif' : '' %>"><%= solde.toLocaleString('fr-FR') %></td>
          <td class="text-end">
            <a href="/achats/<%= item.id %>/modifier" class="btn btn-sm btn-outline-secondary">Modifier</a>
            <form action="/achats/<%= item.id %>/supprimer" method="POST" class="d-inline" onsubmit="return confirm('Supprimer cet achat ?');">
              <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
