<%- include('../partials/header', { titrePage: 'Commandes de couture' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0">Commandes de couture</h3>
  <a href="/commandes/nouveau" class="btn btn-dark">+ Nouvelle commande</a>
</div>

<div class="mb-3">
  <div class="btn-group">
    <a href="/commandes" class="btn btn-sm btn-outline-secondary <%= statut === '' ? 'active' : '' %>">Toutes</a>
    <a href="/commandes?statut=envoye" class="btn btn-sm btn-outline-secondary <%= statut === 'envoye' ? 'active' : '' %>">Envoyées</a>
    <a href="/commandes?statut=recu" class="btn btn-sm btn-outline-secondary <%= statut === 'recu' ? 'active' : '' %>">Reçues</a>
    <a href="/commandes?statut=annule" class="btn btn-sm btn-outline-secondary <%= statut === 'annule' ? 'active' : '' %>">Annulées</a>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover mb-0 align-middle">
      <thead>
        <tr>
          <th>Envoi</th>
          <th>Couturier</th>
          <th>Qualité</th>
          <th>Modèle</th>
          <th class="text-end">Prix unit. couture</th>
          <th class="text-end">Quantité</th>
          <th class="text-end">Total</th>
          <th class="text-end">Solde dû</th>
          <th>Statut</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (lignes.length === 0) { %>
          <tr><td colspan="10" class="text-center text-muted py-4">Aucune commande enregistrée.</td></tr>
        <% } %>
        <% lignes.forEach(item => { const solde = (item.montant_total - item.montant_paye); %>
        <tr>
          <td><%= item.date_envoi %></td>
          <td><%= item.couturier_nom %></td>
          <td><%= item.qualite %></td>
          <td><%= item.modele %></td>
          <td class="text-end"><%= item.prix_unitaire_couture.toLocaleString('fr-FR') %></td>
          <td class="text-end"><%= item.quantite %></td>
          <td class="text-end"><%= item.montant_total.toLocaleString('fr-FR') %></td>
          <td class="text-end <%= solde > 0 ? 'solde-positif' : '' %>"><%= solde.toLocaleString('fr-FR') %></td>
          <td><span class="badge badge-statut-<%= item.statut %>"><%= item.statut %></span></td>
          <td class="text-end text-nowrap">
            <% if (item.statut === 'envoye') { %>
              <form action="/commandes/<%= item.id %>/recevoir" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-success">Marquer reçue</button>
              </form>
            <% } %>
            <a href="/commandes/<%= item.id %>/modifier" class="btn btn-sm btn-outline-secondary">Modifier</a>
            <form action="/commandes/<%= item.id %>/supprimer" method="POST" class="d-inline" onsubmit="return confirm('Supprimer cette commande ?');">
              <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
