
PORT=3000

# Clé secrète utilisée pour sécuriser les sessions (mettez une longue chaîne aléatoire en production)
SESSION_SECRET=changez-cette-cle-secrete-en-production

# --- Connexion à la base de données MySQL ---
# Si vous utilisez le docker-compose.yml fourni, DB_HOST=mysql (nom du service).
# Sinon, DB_HOST=localhost (ou l'adresse de votre serveur MySQL).
DB_HOST=localhost
DB_PORT=3306
DB_USER=gestion_tissus
DB_PASSWORD=Ecowas321/*
DB_NAME=gestion_tissus

# Identifiants du compte administrateur créé automatiquement au premier démarrage
ADMIN_NOM=Administrateur
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234
