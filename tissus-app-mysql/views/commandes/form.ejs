<%- include('../partials/header', { titrePage: (item ? 'Modifier' : 'Nouvelle') + ' commande' }) %>

<h3 class="mb-4"><%= item && item.id ? 'Modifier la commande' : 'Nouvelle commande de couture' %></h3>

<div class="row justify-content-center">
  <div class="col-md-8">
    <% if (!item) { %>
    <div class="card mb-3">
      <div class="card-body p-3">
        <strong>Stock non cousu disponible :</strong>
        <% if (stockDisponible.length === 0) { %>
          <span class="text-muted">aucun stock enregistré.</span>
        <% } else { %>
          <ul class="mb-0 small">
            <% stockDisponible.forEach(s => { %>
              <li><%= s.qualite %> / <%= s.nom_tissu %> : <strong><%= s.stock_disponible %></strong> disponible</li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </div>
    <% } %>
    <div class="card">
      <div class="card-body p-4">
        <% if (erreur) { %><div class="alert alert-danger py-2"><%= erreur %></div><% } %>
        <% if (couturiers.length === 0) { %>
          <div class="alert alert-warning">Aucun couturier enregistré. <a href="/couturiers/nouveau">Ajoutez d'abord un couturier</a>.</div>
        <% } %>
        <form action="<%= item && item.id ? '/commandes/' + item.id : '/commandes' %>" method="POST">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Couturier *</label>
              <select name="couturier_id" class="form-select" required>
                <option value="">-- Choisir --</option>
                <% couturiers.forEach(c => { %>
                  <option value="<%= c.id %>" <%= item && String(item.couturier_id) === String(c.id) ? 'selected' : '' %>><%= c.nom %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Date d'envoi</label>
              <input type="date" name="date_envoi" class="form-control" value="<%= item && item.date_envoi ? item.date_envoi : new Date().toISOString().slice(0,10) %>">
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Qualité *</label>
              <input type="text" name="qualite" class="form-control" value="<%= item && item.qualite ? item.qualite : '' %>" required>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Nom du tissu envoyé</label>
              <input type="text" name="nom_tissu" class="form-control" placeholder="(pour un suivi précis du stock)" value="<%= item && item.nom_tissu ? item.nom_tissu : '' %>">
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Modèle *</label>
              <input type="text" name="modele" class="form-control" placeholder="ex: Robe, Boubou..." value="<%= item && item.modele ? item.modele : '' %>" required>
            </div>
          </div>
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="form-label">Prix unitaire de couture *</label>
              <input type="number" step="0.01" min="0" name="prix_unitaire_couture" class="form-control" value="<%= item && item.prix_unitaire_couture ? item.prix_unitaire_couture : '' %>" required>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Quantité *</label>
              <input type="number" step="0.01" min="0" name="quantite" class="form-control" value="<%= item && item.quantite ? item.quantite : '' %>" required>
            </div>
            <div class="col-md-4 mb-3">
              <label class="form-label">Montant déjà payé</label>
              <input type="number" step="0.01" min="0" name="montant_paye" class="form-control" value="<%= item && item.montant_paye ? item.montant_paye : 0 %>">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Notes</label>
            <textarea name="notes" class="form-control" rows="2"><%= item && item.notes ? item.notes : '' %></textarea>
          </div>
          <button type="submit" class="btn btn-dark">Enregistrer</button>
          <a href="/commandes" class="btn btn-link">Annuler</a>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
