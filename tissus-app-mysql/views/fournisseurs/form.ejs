<%- include('../partials/header', { titrePage: (item ? 'Modifier' : 'Ajouter') + ' un ' + titreSingulier }) %>

<h3 class="mb-4"><%= item && item.id ? 'Modifier' : 'Ajouter' %> un <%= titreSingulier %></h3>

<div class="row justify-content-center">
  <div class="col-md-7">
    <div class="card">
      <div class="card-body p-4">
        <% if (erreur) { %><div class="alert alert-danger py-2"><%= erreur %></div><% } %>
        <form action="<%= item && item.id ? '/' + titrePluriel + '/' + item.id : '/' + titrePluriel %>" method="POST">
          <div class="mb-3">
            <label class="form-label">Nom *</label>
            <input type="text" name="nom" class="form-control" value="<%= item ? item.nom : '' %>" required autofocus>
          </div>
          <div class="mb-3">
            <label class="form-label">Lieu</label>
            <input type="text" name="lieu" class="form-control" value="<%= item && item.lieu ? item.lieu : '' %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Téléphone</label>
            <input type="text" name="telephone" class="form-control" value="<%= item && item.telephone ? item.telephone : '' %>">
          </div>
          <div class="mb-3">
            <label class="form-label">WhatsApp</label>
            <input type="text" name="whatsapp" class="form-control" placeholder="ex: 22890000000" value="<%= item && item.whatsapp ? item.whatsapp : '' %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Notes</label>
            <textarea name="notes" class="form-control" rows="3"><%= item && item.notes ? item.notes : '' %></textarea>
          </div>
          <button type="submit" class="btn btn-dark">Enregistrer</button>
          <a href="/<%= titrePluriel %>" class="btn btn-link">Annuler</a>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
