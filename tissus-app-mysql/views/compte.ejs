<%- include('partials/header', { titrePage: 'Mon compte' }) %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <h3 class="mb-4">Mon compte</h3>
    <div class="card">
      <div class="card-body p-4">
        <p><strong>Nom :</strong> <%= currentUser.nom %></p>
        <p><strong>Email :</strong> <%= currentUser.email %></p>
        <p><strong>Rôle :</strong> <%= currentUser.role === 'admin' ? 'Administrateur' : 'Employé' %></p>
        <hr>
        <h5>Changer le mot de passe</h5>
        <% if (erreur) { %><div class="alert alert-danger py-2"><%= erreur %></div><% } %>
        <% if (succes) { %><div class="alert alert-success py-2"><%= succes %></div><% } %>
        <form action="/compte" method="POST">
          <div class="mb-3">
            <label class="form-label">Mot de passe actuel</label>
            <input type="password" name="mot_de_passe_actuel" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Nouveau mot de passe</label>
            <input type="password" name="nouveau_mot_de_passe" class="form-control" required minlength="6">
          </div>
          <div class="mb-3">
            <label class="form-label">Confirmer le nouveau mot de passe</label>
            <input type="password" name="confirmer_mot_de_passe" class="form-control" required minlength="6">
          </div>
          <button type="submit" class="btn btn-dark">Mettre à jour</button>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
